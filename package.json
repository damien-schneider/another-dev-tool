{
  "name": "another-dev-tool",
  "version": "0.0.20",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:vite": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode dev-app",
    "build:app": "tauri build",
    "install:dev": "bun scripts/install-dev.ts",
    "version": "bun scripts/version.ts",
    "release": "bun scripts/release.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "prepare": "husky",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@ctrl-ui/react": "^0.11.2",
    "@dagrejs/dagre": "^3.1.3",
    "@lezer/common": "1.5.6",
    "@lezer/markdown": "1.8.1",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.4",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.1.10",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.5",
    "@types/node": "^25",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "happy-dom": "^20.3.4",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "tailwindcss": "^4.1.10",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^4.0.17"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  },
  "packageManager": "bun@1.3.5",
  "overrides": {
    "vite": "^7.3.6"
  }
}
